{
  "name": "pr-risk-diff",
  "version": "1.0.0",
  "description": "Advisory PR risk assessment using Google ADK (TypeScript)",
  "type": "module",
  "main": "dist/run-assessment.js",
  "scripts": {
    "build": "tsc",
    "assess": "tsx src/run-assessment.ts",
    "publish": "tsx src/publish-results.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/lib/scoring-guardrails.test.ts"
  },
  "keywords": ["adk", "pr-risk", "github"],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/adk": "^0.2.0",
    "@google/genai": "^1.52.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@google/adk-devtools": "^0.2.0",
    "@eslint/js": "^9.28.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0"
  }
}
